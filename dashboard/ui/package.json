{
  "name": "keyway-dashboard",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun tailwindcss -i src/styles.css -o ../public/styles.css --watch",
    "build": "bun run build:css && bun run build:js",
    "build:css": "bunx --bun tailwindcss -i src/styles.css -o ../public/styles.css --minify",
    "build:js": "bun run build.ts"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-syntax-typescript": "^7.28.6",
    "@babel/plugin-transform-typescript": "^7.28.6",
    "babel-preset-solid": "^1.9.10",
    "daisyui": "^4.12.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@codemirror/language": "^6.12.2",
    "@codemirror/legacy-modes": "^6.5.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.40.0",
    "codemirror": "^6.0.2",
    "solid-js": "^1.9.11"
  }
}
