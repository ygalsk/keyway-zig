{
  "name": "keyway-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test integration/ --preload ./preload.ts --timeout 10000",
    "test:ci": "CLAUDECODE=1 bun test integration/ --preload ./preload.ts --bail --timeout 10000",
    "test:e2e": "bunx playwright test --config e2e/playwright.config.ts",
    "test:e2e:headed": "bunx playwright test --config e2e/playwright.config.ts --headed"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0"
  }
}
